{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screen-frame.schema.json",
  "title": "ScreenFrame",
  "x-version": 1,
  "description": "One frame of a session's screen, pushed over /api/sessions/:id/screen.",
  "type": "object",
  "required": [
    "v"
  ],
  "properties": {
    "v": {
      "description": "Contract version of this message.",
      "type": "integer"
    },
    "text": {
      "description": "Scrollback and screen as lines with ANSI SGR styling; absent when there is no screen to show.",
      "type": "string"
    },
    "cols": {
      "description": "Columns of the tmux window.",
      "type": "integer"
    },
    "rows": {
      "description": "Rows of the tmux window.",
      "type": "integer"
    },
    "reason": {
      "description": "Why there is no screen.",
      "type": "string",
      "enum": [
        "external",
        "gone"
      ]
    }
  }
}
