{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hub-secrets.schema.json",
  "title": "HubSecrets",
  "x-version": 1,
  "description": "Hub secrets, ~/.config/devbox/hub.secrets.toml in the VM (mode 0600).",
  "type": "object",
  "required": [
    "version",
    "app_password_hash",
    "cookie_secret",
    "hub_token"
  ],
  "properties": {
    "version": {
      "description": "Version of this file's format.",
      "type": "integer"
    },
    "app_password_hash": {
      "description": "argon2id hash (PHC string) of the agents app password.",
      "format": "devbox-phc",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "cookie_secret": {
      "description": "Key that signs app session cookies.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "hub_token": {
      "description": "Bearer token the gateway must present.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "vapid_public_key": {
      "description": "Web push application server key, base64url; written by the hub on first run.",
      "type": "string",
      "format": "devbox-nonempty"
    },
    "vapid_private_key": {
      "description": "Web push private key, base64url; written by the hub on first run.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "github_token": {
      "description": "Token for reading deployments and reporting their status.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    }
  }
}
