{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-secrets.schema.json",
  "title": "HostSecrets",
  "x-version": 1,
  "description": "Host secrets, /etc/devbox/secrets.toml (mode 0600).",
  "type": "object",
  "required": [
    "version",
    "wake_password_hash",
    "cookie_secret",
    "hub_token"
  ],
  "properties": {
    "version": {
      "description": "Version of this file's format.",
      "type": "integer"
    },
    "wake_password_hash": {
      "description": "argon2id hash (PHC string) of the password that wakes the VM.",
      "format": "devbox-phc",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "cookie_secret": {
      "description": "Key that signs wake cookies.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "hub_token": {
      "description": "Bearer token the gateway presents to the hub.",
      "format": "devbox-nonempty",
      "type": "string",
      "x-rust-type": {
        "crate": "devbox-core",
        "version": "*",
        "path": "devbox_core::secret::Secret"
      },
      "goJSONSchema": {
        "type": "secret.Secret",
        "imports": [
          "github.com/prabhask5/devbox/internal/secret"
        ]
      }
    },
    "app_password_hash": {
      "description": "argon2id hash of the agents app's password, kept here too so that a rebuilt VM gets it back without anyone being asked. The gateway does not read it.",
      "type": "string",
      "format": "devbox-phc"
    }
  }
}
