{
  "version": 1,
  "instance": "devbox",
  "domain": "example.com",
  "hosts": {
    "code": "code.example.com",
    "agents": "agents.example.com"
  },
  "vm": {
    "address": "10.77.0.10",
    "code_port": 8080,
    "hub_port": 8090,
    "ssh_port": 22
  },
  "sleep": {
    "idle": "15m",
    "min_up": "5m",
    "mode": "stateful",
    "activity_bytes_per_min": 4096
  },
  "gateway": {
    "listen": ":8080",
    "ssh_listen": ":2222",
    "sync_wait": "90s"
  },
  "routing": {
    "provider": "traefik-file",
    "file": "/etc/dokploy/traefik/dynamic/devbox.yml",
    "entrypoint": "websecure",
    "service_url": "http://devbox-gateway:8080"
  },
  "firewall": {
    "manager": "host-firewall"
  },
  "provision": {
    "user": "dev",
    "cpu": 3,
    "memory": "5GiB",
    "disk": "60GiB",
    "image": "images:ubuntu/26.04/cloud",
    "agents": [
      "claude",
      "codex",
      "opencode"
    ],
    "dotfiles": "git@github.com:you/dotfiles"
  },
  "deploy": {
    "repo": "you/devbox",
    "hub_environment": "agents-hub",
    "wake_to_deploy": false
  }
}
