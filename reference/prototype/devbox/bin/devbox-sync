#!/usr/bin/env bash
# devbox-sync — bring every repo in ~/code up to date with GitHub. Runs on every wake (via the hub)
# and on demand (`agent sync` or `devbox-sync`).
#
# For each repo, on its current branch:
#   * clones repos you own on GitHub that aren't in ~/code yet
#   * fetches everything; fast-forwards, or rebases your unpushed commits onto upstream
#   * uncommitted changes (incl. untracked files) are stashed, the update applied, then restored
#   * if anything conflicts, the repo is put back EXACTLY as it was (commits, changes, untracked
#     files) and reported as "conflict"; nothing is ever lost — a backup ref of every stash is kept
#     under refs/devbox-sync/ for 30 days
#   * other local branches that are strictly behind their upstream are fast-forwarded too
#
# --json prints one JSON object per line for the hub (progress shown on the boot screen and phone).
set -uo pipefail
JSON=0; [ "${1:-}" = "--json" ] && JSON=1
CODE="${DEVBOX_CODE_DIR:-$HOME/code}"
STATE="${DEVBOX_STATE_DIR:-$HOME/.local/state/devbox}"
mkdir -p "$CODE" "$STATE"
LOG="$STATE/sync.log"
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

emit() { [ "$JSON" = 1 ] && jq -cn "$@"; return 0; }
result() { # name status detail
  emit --arg name "$1" --arg status "$2" --arg detail "$3" '{type:"repo",name:$name,status:$status,detail:$detail}'
  local icon='·'; case "$2" in updated|cloned) icon='↓';; conflict) icon='⚠';; error) icon='✕';; current) icon='✓';; esac
  [ "$JSON" = 1 ] || printf '  %s %-30s %s\n' "$icon" "$1" "$3"
  printf '%s %s %s %s\n' "$(date -Is)" "$1" "$2" "$3" >>"$LOG"
}

drop_stash() { # drop the stash entry whose commit is $1
  local ref; ref="$(git stash list --format='%H %gd' | awk -v h="$1" '$1==h {print $2; exit}')"
  [ -n "$ref" ] && git stash drop --quiet "$ref"
}

sync_repo() {
  local dir="$1" name; name="$(basename "$dir")"
  emit --arg name "$name" '{type:"begin",name:$name}'
  cd "$dir" || { result "$name" error "can't enter directory"; return; }
  local gd; gd="$(git rev-parse --git-dir 2>/dev/null)" || { result "$name" error "not a git repo"; return; }
  if [ -d "$gd/rebase-merge" ] || [ -d "$gd/rebase-apply" ] || [ -f "$gd/MERGE_HEAD" ] || [ -f "$gd/CHERRY_PICK_HEAD" ] || [ -f "$gd/REVERT_HEAD" ]; then
    result "$name" skipped "a merge/rebase is in progress — finish it first"; return
  fi
  if [ -s "$TMP/$name.fetch-err" ]; then result "$name" error "fetch failed: $(head -c 200 "$TMP/$name.fetch-err" | tr '\n' ' ')"; return; fi

  # expire old safety refs
  local cutoff=$(( $(date +%s) - 30*86400 ))
  git for-each-ref --format='%(refname)' refs/devbox-sync/ | while read -r r; do
    [ "${r##*-}" -lt "$cutoff" ] 2>/dev/null && git update-ref -d "$r"
  done

  # fast-forward other local branches that are strictly behind (safe: no checkout involved)
  local cur; cur="$(git symbolic-ref --quiet --short HEAD || true)"
  local others=0
  while read -r b up; do
    [ -z "$up" ] || [ "$b" = "$cur" ] && continue
    git rev-parse -q --verify "$up" >/dev/null || continue
    if [ "$(git rev-list --count "$up..$b")" = 0 ] && [ "$(git rev-list --count "$b..$up")" != 0 ]; then
      git update-ref "refs/heads/$b" "$(git rev-parse "$up")" "$(git rev-parse "$b")" && others=$((others+1))
    fi
  done < <(git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads)

  [ -n "$cur" ] || { result "$name" skipped "detached HEAD"; return; }
  local up; up="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || { result "$name" skipped "branch $cur has no upstream"; return; }
  local before behind ahead
  before="$(git rev-parse HEAD)"
  behind="$(git rev-list --count HEAD..@{u})"; ahead="$(git rev-list --count @{u}..HEAD)"
  local extra=""; [ "$others" -gt 0 ] && extra=" (+$others other branch$([ "$others" -gt 1 ] && echo es) fast-forwarded)"
  if [ "$behind" = 0 ]; then
    if [ "$ahead" -gt 0 ]; then result "$name" current "up to date; $ahead local commit(s) not pushed$extra"
    else result "$name" current "up to date on $cur$extra"; fi
    return
  fi

  local stash=""
  if [ -n "$(git status --porcelain --untracked-files=normal 2>/dev/null | head -1)" ]; then
    git stash push --include-untracked --quiet -m "devbox-sync $(date -Is)" 2>/dev/null || { result "$name" error "couldn't stash local changes; left untouched"; return; }
    stash="$(git rev-parse -q --verify refs/stash)"
    git update-ref "refs/devbox-sync/backup-$(date +%s)" "$stash"
  fi

  local ok=1 why=""
  if [ "$ahead" = 0 ]; then
    git merge --ff-only --quiet '@{u}' >/dev/null 2>&1 || { ok=0; why="couldn't fast-forward"; }
  else
    if ! git rebase --quiet '@{u}' >/dev/null 2>&1; then
      git rebase --abort >/dev/null 2>&1; ok=0; why="your $ahead unpushed commit(s) conflict with $behind upstream commit(s)"
    fi
  fi

  restore_original() {
    git reset --hard --quiet "$before"
    git clean -fdq >/dev/null 2>&1   # only files a failed stash apply created: all untracked files were stashed
    if [ -n "$stash" ]; then
      if git stash apply --index --quiet "$stash" >/dev/null 2>&1 || git stash apply --quiet "$stash" >/dev/null 2>&1; then drop_stash "$stash"
      else echo "WARNING: couldn't re-apply stash $stash in $name — it is kept in 'git stash list'" >&2; fi
    fi
  }

  if [ "$ok" = 0 ]; then restore_original; result "$name" conflict "$why; left exactly as it was"; return; fi

  if [ -n "$stash" ]; then
    if ! git stash apply --quiet "$stash" >/dev/null 2>&1; then
      restore_original
      result "$name" conflict "your uncommitted changes conflict with $behind new upstream commit(s); left exactly as it was"
      return
    fi
    drop_stash "$stash"
  fi
  local d="pulled $behind commit(s)"
  [ "$ahead" -gt 0 ] && d="$d, rebased $ahead local"
  [ -n "$stash" ] && d="$d, kept your uncommitted changes"
  result "$name" updated "$d$extra"
}

# ---- discover
declare -A have=()
repos=()
for d in "$CODE"/*/; do [ -d "$d/.git" ] && { repos+=("${d%/}"); have["$(basename "$d")"]=1; }; done
missing=()
if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  grep -q github.com ~/.ssh/known_hosts 2>/dev/null || ssh-keyscan -t ed25519 github.com >>~/.ssh/known_hosts 2>/dev/null
  while read -r name url; do
    [ -n "$name" ] && [ -z "${have[$name]:-}" ] && missing+=("$name $url")
  done < <(gh repo list --limit 500 --no-archived --json name,sshUrl -q '.[] | "\(.name) \(.sshUrl)"' 2>/dev/null)
fi
emit --argjson total $(( ${#repos[@]} + ${#missing[@]} )) '{type:"start",total:$total}'
[ "$JSON" = 1 ] || echo "Syncing ${#repos[@]} repo(s) in $CODE${missing:+, cloning ${#missing[@]}}"
echo "$(date -Is) --- sync start (${#repos[@]} local, ${#missing[@]} new)" >>"$LOG"

# ---- fetch everything in parallel (the slow part), then update repos one by one (fast, local)
emit '{type:"begin",name:"fetching"}'
printf '%s\n' "${repos[@]}" | xargs -P 6 -I{} sh -c 'git -C "$1" fetch --all --prune --quiet 2>"$2/$(basename "$1").fetch-err" || true' _ {} "$TMP"

for line in "${missing[@]}"; do
  name="${line%% *}"; url="${line#* }"
  emit --arg name "$name" '{type:"begin",name:$name}'
  if git clone --quiet "$url" "$CODE/$name" 2>"$TMP/$name.clone-err"; then result "$name" cloned "new on GitHub"
  else result "$name" error "clone failed: $(head -c 200 "$TMP/$name.clone-err" | tr '\n' ' ')"; fi
done
for dir in "${repos[@]}"; do (sync_repo "$dir"); done
emit '{type:"done"}'
echo "$(date -Is) --- sync done" >>"$LOG"
