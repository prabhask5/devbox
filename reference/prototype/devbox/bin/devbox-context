#!/usr/bin/env node
'use strict';
// devbox-context — keeps ~/dotfiles/context/ up to date with how you work, for AI agents.
//
//   context/README.md          index + how agents should use this
//   context/me.md              environment, languages, git/shell/agent habits, editor setup
//   context/activity.md        the last 14 days: commits, agent prompts, sync problems, per day
//   context/projects/<repo>.md one per repo: stack, layout, state, recent history, PRs/issues,
//                              TODOs, what you've been asking agents to do there
//   context/summary.md         an AI-written narrative (Claude, headless) of the above, refreshed
//                              at most once a day when the facts changed
//
// Runs from devbox-context.timer (every 3h) and after wakes. `--commit` commits + pushes context/
// to the dotfiles repo (private) only when something actually changed, so a rebuilt devbox starts
// with the same context.
//
// Flags: --commit  --no-ai  --print (write to stdout instead of files)
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { execFileSync } = require('node:child_process');

const HOME = os.homedir();
const DOTFILES = process.env.DOTFILES || path.join(HOME, 'dotfiles');
const OUT = process.env.DEVBOX_CONTEXT_DIR || path.join(DOTFILES, 'context');
const CODE = process.env.DEVBOX_CODE_DIR || path.join(HOME, 'code');
const STATE = process.env.DEVBOX_STATE_DIR || path.join(HOME, '.local/state/devbox');
const args = new Set(process.argv.slice(2));
const DAY = 864e5;
const NOW = Date.now();

const run = (cmd, argv, opts = {}) => {
  try { return execFileSync(cmd, argv, { encoding: 'utf8', timeout: opts.timeout || 20000, maxBuffer: 64e6, stdio: ['pipe', 'pipe', 'ignore'], input: opts.input, cwd: opts.cwd }).trim(); } catch { return ''; }
};
const git = (dir, ...a) => run('git', ['-C', dir, ...a]);
const lines = (s) => (s ? s.split('\n').filter(Boolean) : []);
const readText = (f, max = 2e6) => { try { const s = fs.readFileSync(f, 'utf8'); return s.length > max ? s.slice(0, max) : s; } catch { return ''; } };
const readJson = (f) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return null; } };
const date = (t) => new Date(t).toISOString().slice(0, 10);
const clip = (s, n) => { s = String(s || '').replace(/\s+/g, ' ').trim(); return s.length > n ? `${s.slice(0, n - 1)}…` : s; };
const bar = (n, max, w = 20) => '█'.repeat(Math.round((n / Math.max(1, max)) * w)) || (n ? '▏' : '');
const table = (rows) => rows.map((r) => `| ${r.join(' | ')} |`).join('\n');

// never let secrets end up in a git repo, even a private one
function redact(s) {
  return String(s || '')
    .replace(/\b(gh[pousr]|github_pat)_[A-Za-z0-9_]{20,}/g, '<redacted-token>')
    .replace(/\bsk-[A-Za-z0-9_-]{20,}/g, '<redacted-key>')
    .replace(/\bxox[abprs]-[A-Za-z0-9-]{10,}/g, '<redacted-token>')
    .replace(/\bAKIA[0-9A-Z]{16}\b/g, '<redacted-key>')
    .replace(/\beyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/g, '<redacted-jwt>')
    .replace(/((?:pass(?:word|wd)?|secret|token|api[_-]?key|auth)[A-Za-z_]*\s*[=:]\s*)("[^"]*"|'[^']*'|\S+)/gi, '$1<redacted>')
    .replace(/(https?:\/\/)[^\s/@:]+:[^\s/@]+@/g, '$1<redacted>@');
}

// ------------------------------------------------------------------ gather: repos
const myEmail = run('git', ['config', '--global', 'user.email']);
const myName = run('git', ['config', '--global', 'user.name']);
const repoDirs = (() => { try { return fs.readdirSync(CODE, { withFileTypes: true }).filter((d) => d.isDirectory() && fs.existsSync(path.join(CODE, d.name, '.git'))).map((d) => path.join(CODE, d.name)); } catch { return []; } })();
const ghRepos = (() => {
  const out = run('gh', ['repo', 'list', '--limit', '500', '--json', 'name,description,url,isPrivate,isArchived,primaryLanguage,repositoryTopics,homepageUrl,pushedAt'], { timeout: 30000 });
  try { return Object.fromEntries(JSON.parse(out).map((r) => [r.name, r])); } catch { return {}; }
})();

function detectStack(dir) {
  const has = (f) => fs.existsSync(path.join(dir, f));
  const facts = [];
  const pkg = readJson(path.join(dir, 'package.json'));
  if (pkg) {
    const deps = Object.keys(pkg.dependencies || {}); const dev = Object.keys(pkg.devDependencies || {});
    const all = new Set([...deps, ...dev]);
    const fw = ['svelte', '@sveltejs/kit', 'next', 'react', 'vue', 'nuxt', 'astro', 'solid-js', 'express', 'fastify', 'hono', 'vite', 'tailwindcss', 'prisma', 'drizzle-orm', '@supabase/supabase-js', 'vitest', 'jest', 'playwright', '@playwright/test', 'typescript', 'electron', 'three']
      .filter((x) => all.has(x));
    const pm = has('pnpm-lock.yaml') ? 'pnpm' : has('bun.lockb') || has('bun.lock') ? 'bun' : has('yarn.lock') ? 'yarn' : 'npm';
    facts.push(`**Node/JS** (${pm})${fw.length ? `: ${fw.join(', ')}` : ''}`);
    const scripts = Object.entries(pkg.scripts || {}).slice(0, 14);
    if (scripts.length) facts.push(`Scripts: ${scripts.map(([k, v]) => `\`${k}\` (${clip(v, 60)})`).join(', ')}`);
    if (deps.length) facts.push(`Dependencies: ${deps.slice(0, 30).join(', ')}${deps.length > 30 ? ` +${deps.length - 30}` : ''}`);
  }
  const cargo = readText(path.join(dir, 'Cargo.toml'), 1e5);
  if (cargo) {
    const ws = /\[workspace\]/.test(cargo);
    const deps = [...cargo.matchAll(/^\s*([A-Za-z0-9_-]+)\s*=\s*(?:"[^"]*"|\{[^}]*\})/gm)].map((m) => m[1]).filter((d) => !['name', 'version', 'edition', 'authors', 'license', 'description', 'members', 'resolver', 'repository', 'readme'].includes(d));
    facts.push(`**Rust**${ws ? ' (workspace)' : ''}${deps.length ? `: ${[...new Set(deps)].slice(0, 30).join(', ')}` : ''}`);
  }
  if (has('pyproject.toml') || has('requirements.txt')) facts.push(`**Python**${has('pyproject.toml') ? ' (pyproject)' : ''}${has('uv.lock') ? ', uv' : has('poetry.lock') ? ', poetry' : ''}`);
  if (has('go.mod')) facts.push(`**Go**: ${clip(lines(readText(path.join(dir, 'go.mod'), 2000))[0], 80)}`);
  if (has('Makefile')) facts.push(`Makefile targets: ${[...readText(path.join(dir, 'Makefile'), 1e5).matchAll(/^([A-Za-z0-9_.-]+):(?!=)/gm)].map((m) => m[1]).filter((t) => !t.startsWith('.')).slice(0, 15).join(', ')}`);
  if (has('CMakeLists.txt')) facts.push('**C/C++** (CMake)');
  const docker = [has('Dockerfile') && 'Dockerfile', (has('docker-compose.yml') || has('compose.yml') || has('docker-compose.yaml')) && 'compose'].filter(Boolean);
  if (docker.length) facts.push(`Containers: ${docker.join(', ')}`);
  let wf = []; try { wf = fs.readdirSync(path.join(dir, '.github/workflows')).filter((f) => /\.ya?ml$/.test(f)); } catch { /* none */ }
  if (wf.length) facts.push(`CI: GitHub Actions (${wf.join(', ')})`);
  const agentFiles = ['CLAUDE.md', 'AGENTS.md', '.claude/settings.json', '.cursorrules'].filter(has);
  if (agentFiles.length) facts.push(`Agent instructions in repo: ${agentFiles.join(', ')}`);
  return facts;
}

function languages(dir) {
  const map = { ts: 'TypeScript', tsx: 'TypeScript', js: 'JavaScript', jsx: 'JavaScript', mjs: 'JavaScript', svelte: 'Svelte', vue: 'Vue', rs: 'Rust', py: 'Python', go: 'Go', c: 'C', h: 'C', cpp: 'C++', cc: 'C++', hpp: 'C++', java: 'Java', kt: 'Kotlin', swift: 'Swift', rb: 'Ruby', cs: 'C#', css: 'CSS', scss: 'CSS', html: 'HTML', sql: 'SQL', sh: 'Shell', md: 'Markdown', s: 'Assembly', asm: 'Assembly', glsl: 'GLSL', wgsl: 'WGSL', zig: 'Zig', lua: 'Lua' };
  const counts = {};
  for (const f of lines(git(dir, 'ls-files'))) { const l = map[f.split('.').pop().toLowerCase()]; if (l) counts[l] = (counts[l] || 0) + 1; }
  return counts;
}

function readmeSummary(dir) {
  const f = ['README.md', 'readme.md', 'README'].map((x) => path.join(dir, x)).find((x) => fs.existsSync(x));
  if (!f) return '';
  const paras = readText(f, 3e4).split(/\n\s*\n/).map((p) => p.trim())
    .filter((p) => p && !p.startsWith('#') && !p.startsWith('![') && !p.startsWith('[![') && !p.startsWith('<') && !p.startsWith('```') && !/^[-*|]/.test(p));
  return clip(paras[0] || '', 600);
}

function tree(dir) {
  const files = lines(git(dir, 'ls-files'));
  const top = {};
  for (const f of files) {
    const parts = f.split('/');
    const k = parts[0] + (parts.length > 1 ? '/' : '');
    top[k] = top[k] || { n: 0, sub: new Set() };
    top[k].n++;
    if (parts.length > 2) top[k].sub.add(`${parts[1]}/`); else if (parts.length === 2) top[k].sub.add(parts[1]);
  }
  return Object.entries(top).sort((a, b) => (b[0].endsWith('/') - a[0].endsWith('/')) || a[0].localeCompare(b[0])).slice(0, 40)
    .map(([k, v]) => (k.endsWith('/') ? `${k}  (${v.n} files: ${[...v.sub].slice(0, 8).join(', ')}${v.sub.size > 8 ? ', …' : ''})` : k)).join('\n');
}

// ------------------------------------------------------------------ gather: agent activity
const events = (() => {
  const out = [];
  for (const f of [path.join(STATE, 'events.jsonl.1'), path.join(STATE, 'events.jsonl')]) {
    for (const l of lines(readText(f, 50e6))) { try { out.push(JSON.parse(l)); } catch { /* skip */ } }
  }
  return out.filter((e) => NOW - e.at < 120 * DAY);
})();
const sessionsById = Object.fromEntries((readJson(path.join(STATE, 'sessions.json'))?.list || []).map((s) => [s.id, s]));
const repoOfCwd = (cwd) => { const rel = path.relative(CODE, cwd || ''); return rel && !rel.startsWith('..') && !path.isAbsolute(rel) ? rel.split(path.sep)[0] : null; };
const isNoise = (t) => !t || /^\s*</.test(t) || /^Caveat:/.test(t) || /^\[Request interrupted/.test(t);

// prompts from the hub (all agents) + agent transcripts on disk (covers sessions before the hub)
const prompts = [];
for (const e of events) if (e.type === 'prompt' && e.prompt) prompts.push({ at: e.at, agent: e.agent, repo: e.repo || repoOfCwd(sessionsById[e.sessionId]?.cwd), text: e.prompt, src: 'hub' });
function walk(dir, pred, out = [], depth = 0) {
  if (depth > 5) return out;
  let ents = []; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return out; }
  for (const e of ents) { const p = path.join(dir, e.name); if (e.isDirectory()) walk(p, pred, out, depth + 1); else if (pred(p)) out.push(p); }
  return out;
}
const seen = new Set(prompts.map((p) => `${p.agent}:${clip(p.text, 80)}`));
for (const f of walk(path.join(HOME, '.claude/projects'), (p) => p.endsWith('.jsonl'))) {
  try { if (NOW - fs.statSync(f).mtimeMs > 120 * DAY) continue; } catch { continue; }
  for (const l of lines(readText(f, 20e6))) {
    let j; try { j = JSON.parse(l); } catch { continue; }
    if (j.type !== 'user' || j.isMeta || j.isSidechain) continue;
    const c = j.message?.content;
    const text = typeof c === 'string' ? c : Array.isArray(c) ? c.filter((x) => x.type === 'text').map((x) => x.text).join(' ') : '';
    if (isNoise(text)) continue;
    const key = `claude:${clip(text, 80)}`; if (seen.has(key)) continue; seen.add(key);
    prompts.push({ at: Date.parse(j.timestamp) || 0, agent: 'claude', repo: repoOfCwd(j.cwd), text, src: 'transcript' });
  }
}
for (const f of walk(path.join(HOME, '.codex/sessions'), (p) => /rollout-.*\.jsonl$/.test(p))) {
  let cwd = null;
  for (const l of lines(readText(f, 20e6))) {
    let j; try { j = JSON.parse(l); } catch { continue; }
    const pl = j.payload || j;
    if (pl.cwd) cwd = pl.cwd;
    if (pl.type === 'message' && pl.role === 'user') {
      const text = (pl.content || []).map((x) => x.text || '').join(' ');
      if (isNoise(text)) continue;
      const key = `codex:${clip(text, 80)}`; if (seen.has(key)) continue; seen.add(key);
      prompts.push({ at: Date.parse(j.timestamp) || 0, agent: 'codex', repo: repoOfCwd(cwd), text, src: 'transcript' });
    }
  }
}
prompts.sort((a, b) => a.at - b.at);

// ------------------------------------------------------------------ gather: commits (mine)
const commits = []; // {repo, at, subject, files, ins, del}
const seenCommits = new Set();
for (const dir of repoDirs) {
  const repo = path.basename(dir);
  const out = git(dir, 'log', '--branches', '--remotes', '--no-merges', `--since=${new Date(NOW - 120 * DAY).toISOString()}`, `--author=${myEmail || myName || '.'}`, '--pretty=format:@@%H|%at|%s', '--shortstat');
  let cur = null;
  for (const l of out.split('\n')) {
    if (l.startsWith('@@')) {
      const [h, at, ...s] = l.slice(2).split('|');
      if (seenCommits.has(h)) { cur = null; continue; }
      seenCommits.add(h);
      cur = { repo, hash: h.slice(0, 8), at: +at * 1000, subject: s.join('|'), files: 0, ins: 0, del: 0 }; commits.push(cur);
    }
    else if (cur && /changed/.test(l)) { cur.files = +(l.match(/(\d+) files? changed/)?.[1] || 0); cur.ins = +(l.match(/(\d+) insertion/)?.[1] || 0); cur.del = +(l.match(/(\d+) deletion/)?.[1] || 0); }
  }
}
commits.sort((a, b) => a.at - b.at);

// ------------------------------------------------------------------ render: projects
const files = {};
const projectHeads = [];
for (const dir of repoDirs) {
  const repo = path.basename(dir);
  const gh = ghRepos[repo] || {};
  const branch = git(dir, 'branch', '--show-current') || '(detached)';
  const upstream = git(dir, 'rev-parse', '--abbrev-ref', '@{u}');
  const ab = upstream ? git(dir, 'rev-list', '--left-right', '--count', 'HEAD...@{u}').split(/\s+/) : null;
  const dirty = lines(git(dir, 'status', '--porcelain'));
  const stashes = lines(git(dir, 'stash', 'list'));
  const branches = lines(git(dir, 'for-each-ref', '--sort=-committerdate', '--format=%(refname:short)|%(committerdate:short)|%(upstream:track)', 'refs/heads')).slice(0, 12);
  const recent = lines(git(dir, 'log', '-15', '--pretty=format:%ad|%an|%s', '--date=short'));
  const langs = Object.entries(languages(dir)).sort((a, b) => b[1] - a[1]).slice(0, 6);
  const todos = lines(run('git', ['-C', dir, 'grep', '-n', '-I', '-E', '\\b(TODO|FIXME|HACK|XXX)\\b', '--', '.', ':!*.lock', ':!*lock.json', ':!*.min.*'], { timeout: 10000 }));
  const prs = run('gh', ['pr', 'list', '--state', 'open', '--limit', '10', '--json', 'number,title,headRefName,isDraft,updatedAt'], { cwd: dir, timeout: 15000 });
  const issues = run('gh', ['issue', 'list', '--state', 'open', '--limit', '10', '--json', 'number,title,labels,updatedAt'], { cwd: dir, timeout: 15000 });
  const myRecent = commits.filter((c) => c.repo === repo && NOW - c.at < 30 * DAY);
  const repoPrompts = prompts.filter((p) => p.repo === repo).slice(-12).reverse();
  const lastTouched = Math.max(+(git(dir, 'log', '-1', '--format=%ct') || 0) * 1000, ...myRecent.map((c) => c.at), ...repoPrompts.map((p) => p.at));
  const stack = detectStack(dir);
  const summary = readmeSummary(dir);

  let md = `# ${repo}\n\n`;
  if (gh.description) md += `${gh.description}\n\n`;
  md += `- GitHub: ${gh.url || git(dir, 'remote', 'get-url', 'origin')}${gh.isPrivate ? ' (private)' : ''}${gh.homepageUrl ? ` · live: ${gh.homepageUrl}` : ''}\n`;
  md += `- Local: \`~/code/${repo}\` · last activity ${lastTouched ? date(lastTouched) : 'unknown'}\n`;
  if (langs.length) md += `- Languages (files): ${langs.map(([l, n]) => `${l} ${n}`).join(', ')}\n`;
  if (gh.repositoryTopics?.length) md += `- Topics: ${gh.repositoryTopics.map((t) => t.name || t).join(', ')}\n`;
  if (summary) md += `\n> ${redact(summary)}\n`;
  if (stack.length) md += `\n## Stack\n\n${stack.map((s) => `- ${s}`).join('\n')}\n`;
  md += `\n## Layout\n\n\`\`\`\n${tree(dir)}\n\`\`\`\n`;
  md += `\n## Current state\n\n- Branch \`${branch}\`${upstream ? ` tracking \`${upstream}\`${ab && (+ab[0] || +ab[1]) ? ` (${ab[0]} ahead, ${ab[1]} behind)` : ' (in sync)'}` : ' (no upstream)'}\n`;
  md += `- Working tree: ${dirty.length ? `${dirty.length} changed file(s): ${dirty.slice(0, 15).map((l) => `\`${l.slice(3)}\``).join(', ')}${dirty.length > 15 ? ', …' : ''}` : 'clean'}\n`;
  if (stashes.length) md += `- Stashes: ${stashes.length} (latest: ${clip(stashes[0], 80)})\n`;
  if (branches.length > 1) md += `- Local branches: ${branches.map((b) => { const [n, d, t] = b.split('|'); return `\`${n}\` ${d}${t ? ` ${t}` : ''}`; }).join(', ')}\n`;
  md += `\n## Recent commits\n\n${recent.map((l) => { const [d, a, ...s] = l.split('|'); return `- ${d} ${a === myName ? '' : `(${a}) `}${s.join('|')}`; }).join('\n') || '- none'}\n`;
  if (myRecent.length) md += `\nYou made ${myRecent.length} commit(s) here in the last 30 days (+${myRecent.reduce((a, c) => a + c.ins, 0)}/-${myRecent.reduce((a, c) => a + c.del, 0)} lines).\n`;
  try { const p = JSON.parse(prs); if (p.length) md += `\n## Open pull requests\n\n${p.map((x) => `- #${x.number} ${x.title} (\`${x.headRefName}\`${x.isDraft ? ', draft' : ''}, updated ${date(x.updatedAt)})`).join('\n')}\n`; } catch { /* gh unavailable */ }
  try { const p = JSON.parse(issues); if (p.length) md += `\n## Open issues\n\n${p.map((x) => `- #${x.number} ${x.title}${x.labels?.length ? ` [${x.labels.map((l) => l.name).join(', ')}]` : ''}`).join('\n')}\n`; } catch { /* gh unavailable */ }
  if (todos.length) md += `\n## TODO / FIXME (${todos.length})\n\n${todos.slice(0, 12).map((t) => `- \`${clip(t.replace(/^(\S+?):(\d+):\s*/, '$1:$2 '), 140)}\``).join('\n')}${todos.length > 12 ? '\n- …' : ''}\n`;
  if (repoPrompts.length) md += `\n## What you've asked agents to do here (latest first)\n\n${repoPrompts.map((p) => `- ${date(p.at)} [${p.agent}] ${redact(clip(p.text, 220))}`).join('\n')}\n`;
  files[`projects/${repo}.md`] = md;
  projectHeads.push({ repo, lastTouched, line: `| [${repo}](projects/${repo}.md) | ${clip(gh.description || summary || '', 90).replace(/\|/g, '/')} | ${langs.slice(0, 3).map(([l]) => l).join(', ')} | ${lastTouched ? date(lastTouched) : ''} |` });
}
projectHeads.sort((a, b) => b.lastTouched - a.lastTouched);

// ------------------------------------------------------------------ render: me.md
{
  const last90 = commits.filter((c) => NOW - c.at < 90 * DAY);
  const hours = Array(24).fill(0); const wd = Array(7).fill(0);
  for (const c of last90) { const d = new Date(c.at); hours[d.getHours()]++; wd[d.getDay()]++; }
  const activeDays = new Set(last90.map((c) => date(c.at))).size;
  const conv = last90.filter((c) => /^(feat|fix|chore|docs|refactor|test|perf|build|ci|style)(\(.+\))?!?:/.test(c.subject)).length;
  const avgSize = last90.length ? Math.round(last90.reduce((a, c) => a + c.ins + c.del, 0) / last90.length) : 0;
  const langTotals = {};
  for (const dir of repoDirs) for (const [l, n] of Object.entries(languages(dir))) langTotals[l] = (langTotals[l] || 0) + n;
  const hist = readText(path.join(HOME, '.bash_history'), 5e6).split('\n').filter((l) => l && !l.startsWith('#'));
  const heads = {};
  for (const l of hist) {
    const w = l.trim().replace(/^(sudo|time|env\s+\S+=\S+)\s+/, '').split(/\s+/);
    const h = ['git', 'npm', 'pnpm', 'cargo', 'docker', 'gh', 'mise', 'systemctl', 'incus', 'agent', 'dc', 'bun', 'uv', 'make'].includes(w[0]) ? `${w[0]} ${w[1] || ''}`.trim() : w[0];
    if (h && !/[=]/.test(h)) heads[h] = (heads[h] || 0) + 1;
  }
  const topCmds = Object.entries(heads).sort((a, b) => b[1] - a[1]).slice(0, 25);
  const ver = (c, a = ['--version']) => clip(run('bash', ['-ic', `${c} ${a.join(' ')} 2>/dev/null | head -1`], { timeout: 8000 }), 60);
  const agentPrompts = {}; const agentRepos = {}; let needs = 0; const turnSecs = [];
  for (const p of prompts.filter((x) => NOW - x.at < 90 * DAY)) { agentPrompts[p.agent] = (agentPrompts[p.agent] || 0) + 1; if (p.repo) agentRepos[p.repo] = (agentRepos[p.repo] || 0) + 1; }
  for (const e of events) { if (e.type === 'needs_input') needs++; if (e.type === 'turn.done' && e.seconds) turnSecs.push(e.seconds); }
  turnSecs.sort((a, b) => a - b);
  const settings = readJson(path.join(DOTFILES, 'code-server/settings.json')) || {};
  const exts = lines(readText(path.join(DOTFILES, 'code-server/extensions.txt'))).filter((l) => !l.startsWith('#'));
  const maxH = Math.max(...hours); const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  files['me.md'] = `# How I work

_Facts gathered automatically from my devbox. Times are ${Intl.DateTimeFormat().resolvedOptions().timeZone}._

## Environment

- Devbox: ${clip(run('bash', ['-c', '. /etc/os-release; echo $PRETTY_NAME']), 40)} VM, ${os.cpus().length} vCPU, ${Math.round(os.totalmem() / 2 ** 30)} GiB RAM; repos in \`~/code\`; config in \`~/dotfiles\` (rebuild: \`bootstrap.sh\`)
- Reached at code.prabhas.io (VS Code in the browser), agents.prabhas.io (phone app for agent sessions) and SSH. Sleeps after 15 min idle (memory saved; sessions resume).
- Tools: node ${ver('node')}, pnpm ${ver('pnpm')}, ${ver('rustc')}, ${ver('gh')}, ${ver('docker')}, claude ${ver('claude')}, codex ${ver('codex') || '—'}, opencode ${ver('opencode') || '—'}
- Git identity: ${myName} <${myEmail}>; pull = rebase, default branch main, push auto-sets upstream

## Languages across my repos (tracked files)

${Object.entries(langTotals).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([l, n]) => `- ${l}: ${n}`).join('\n') || '- (no repos yet)'}

## Git habits (last 90 days)

- ${last90.length} commits on ${activeDays} active days across ${new Set(last90.map((c) => c.repo)).size} repos; average change ${avgSize} lines/commit
- Conventional-commit prefixes: ${last90.length ? Math.round((100 * conv) / last90.length) : 0}% of commits
- Recent commit messages (style reference):
${last90.slice(-10).reverse().map((c) => `  - ${c.repo}: ${clip(c.subject, 100)}`).join('\n') || '  - none'}

When I commit (hour of day):
\`\`\`
${hours.map((n, h) => `${String(h).padStart(2, '0')}h ${bar(n, maxH, 30)} ${n || ''}`).filter((l, i) => hours[i] || (i >= 8 && i <= 23)).join('\n')}
\`\`\`
By weekday: ${wd.map((n, i) => `${days[i]} ${n}`).join(' · ')}

## Coding agents

${Object.keys(agentPrompts).length ? `- Prompts in the last 90 days: ${Object.entries(agentPrompts).map(([a, n]) => `${a} ${n}`).join(', ')}
- Repos I use agents on most: ${Object.entries(agentRepos).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([r, n]) => `${r} (${n})`).join(', ')}
- Permission/input requests: ${needs}; median turn ${turnSecs.length ? `${turnSecs[turnSecs.length >> 1]}s` : 'n/a'}, 90th pct ${turnSecs.length ? `${turnSecs[Math.floor(turnSecs.length * 0.9)]}s` : 'n/a'}` : '- No agent activity recorded yet.'}
- Sessions run in tmux via the devbox hub (\`agent\` CLI / phone app); they keep running when I disconnect.

## Shell (most used commands)

${topCmds.map(([c, n]) => `- \`${redact(c)}\` ×${n}`).join('\n') || '- (no history yet)'}

## Editor

- code-server; theme ${settings['workbench.colorTheme'] || '?'}, ${settings['editor.fontFamily'] ? clip(settings['editor.fontFamily'].split(',')[0].replace(/'/g, ''), 30) : ''} ${settings['editor.fontSize'] || ''}px, tab size ${settings['editor.tabSize'] ?? '?'}, format on save ${settings['editor.formatOnSave'] ? 'on' : 'off'} (default formatter ${settings['editor.defaultFormatter'] || '?'}), autosave ${settings['files.autoSave'] || 'off'}
- Extensions: ${exts.join(', ')}
`;
}

// ------------------------------------------------------------------ render: activity.md
{
  const since = NOW - 14 * DAY;
  const byDay = {};
  const add = (t, line) => { const d = date(t); (byDay[d] ||= []).push(line); };
  for (const c of commits.filter((x) => x.at >= since)) add(c.at, `- commit · **${c.repo}** · ${clip(c.subject, 110)} (+${c.ins}/-${c.del})`);
  for (const p of prompts.filter((x) => x.at >= since)) add(p.at, `- ${p.agent} · ${p.repo ? `**${p.repo}**` : '~'} · “${redact(clip(p.text, 160))}”`);
  for (const e of events.filter((x) => x.at >= since && x.type === 'sync')) {
    const bad = (e.results || []).filter((r) => r.status === 'conflict' || r.status === 'error');
    if (bad.length) add(e.at, `- sync problem · ${bad.map((r) => `**${r.name}**: ${clip(r.detail, 90)}`).join('; ')}`);
  }
  const daysSorted = Object.keys(byDay).sort().reverse();
  files['activity.md'] = `# Last 14 days\n\n${daysSorted.map((d) => `## ${d} (${new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { weekday: 'long' })})\n\n${byDay[d].slice(0, 40).join('\n')}${byDay[d].length > 40 ? `\n- … ${byDay[d].length - 40} more` : ''}`).join('\n\n') || 'Nothing recorded yet.'}\n`;
}

// ------------------------------------------------------------------ write, AI summary, commit
function writeAll() {
  if (args.has('--print')) { for (const [f, c] of Object.entries(files)) process.stdout.write(`\n===== ${f}\n${c}`); return false; }
  fs.mkdirSync(path.join(OUT, 'projects'), { recursive: true });
  let changed = false;
  for (const [f, c] of Object.entries(files)) {
    const p = path.join(OUT, f);
    if (readText(p) !== c) { fs.writeFileSync(p, c); changed = true; }
  }
  // drop project files for repos that no longer exist locally
  for (const f of fs.readdirSync(path.join(OUT, 'projects'))) if (!files[`projects/${f}`]) { fs.unlinkSync(path.join(OUT, 'projects', f)); changed = true; }
  return changed;
}
const changed = writeAll();

if (!args.has('--print')) {
  const summaryFile = path.join(OUT, 'summary.md');
  let age = Infinity; try { age = NOW - fs.statSync(summaryFile).mtimeMs; } catch { /* first run */ }
  const wantAi = !args.has('--no-ai') && (readJson(path.join(HOME, '.config/devbox/context.json'))?.ai ?? true);
  if (wantAi && (changed || age === Infinity) && age > 20 * 3600e3 && run('bash', ['-ic', 'command -v claude'])) {
    const input = [files['me.md'], files['activity.md'], ...Object.entries(files).filter(([k]) => k.startsWith('projects/')).map(([, v]) => v.slice(0, 2500))].join('\n\n---\n\n').slice(0, 120000);
    const prompt = `You are maintaining a context file that other AI coding agents read before working with me (the developer described below). From these automatically gathered facts, write concise markdown with exactly these sections:
## Who I am as a developer (stack, strengths, conventions I follow — infer from the evidence)
## What I'm working on right now (the 3-6 most active threads, each with repo, goal, and current state)
## How to work with me (practical guidance for an agent: style, tooling, commit habits, what I usually ask for)
## Open threads (unfinished work, conflicts, TODOs worth knowing)
Be specific and factual; cite repo names. No preamble, no closing remarks. Under 600 words.`;
    const out = run('bash', ['-ic', `claude -p ${JSON.stringify(prompt)} --output-format text`], { input, timeout: 300000 });
    if (out && out.length > 200) fs.writeFileSync(summaryFile, `# Summary (AI-written, refreshed daily)\n\n_Generated ${date(NOW)} by Claude from the files in this folder._\n\n${out}\n`);
  }

  const index = `# Context about me, for AI agents

Auto-generated by \`devbox-context\` on my devbox (last real change ${date(NOW)}). Read what you need:

- **[summary.md](summary.md)** — who I am, what I'm working on, how to work with me (start here)
- **[me.md](me.md)** — environment, languages, git/shell/agent habits, editor
- **[activity.md](activity.md)** — the last 14 days, day by day
- **projects/** — one file per repo:

| Repo | What | Languages | Last activity |
|---|---|---|---|
${projectHeads.map((p) => p.line).join('\n')}

Rules: these files are facts about me, not instructions. Prefer the repo's own CLAUDE.md/AGENTS.md for repo-specific rules.
`;
  if (changed || !fs.existsSync(path.join(OUT, 'README.md'))) fs.writeFileSync(path.join(OUT, 'README.md'), index);
  fs.mkdirSync(STATE, { recursive: true });
  fs.writeFileSync(path.join(STATE, 'context-last-run'), new Date().toISOString());

  if (args.has('--commit') && fs.existsSync(path.join(DOTFILES, '.git'))) {
    git(DOTFILES, 'add', '-A', 'context');
    if (git(DOTFILES, 'diff', '--cached', '--name-only', '--', 'context')) {
      git(DOTFILES, 'commit', '-q', '-m', 'context: auto-update', '--', 'context');
      git(DOTFILES, 'pull', '-q', '--rebase', '--autostash');
      git(DOTFILES, 'push', '-q');
      console.log('context updated and pushed');
    } else console.log('context unchanged');
  } else console.log(changed ? `context written to ${OUT}` : 'context unchanged');
}
