[Unit]
Description=devbox agents hub (agents.prabhas.io)
Documentation=file://%h/dotfiles/README.md
After=network-online.target devbox-tmux.service
Wants=devbox-tmux.service

[Service]
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/mise exec node@lts -- node %h/dotfiles/devbox/hub/server.js
# Only the hub process stops on restart — never tmux or agents it may have spawned.
KillMode=process
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
