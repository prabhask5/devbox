[Unit]
Description=Refresh AI context about my workflow (~/dotfiles/context)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/mise exec node@lts -- node %h/dotfiles/devbox/bin/devbox-context --commit
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
