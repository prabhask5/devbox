# Copy to .env (chmod 600). Only WAKE_PASSWORD_HASH is required.
# Generate:  docker run --rm local/devbox-gateway node server.js hash-password 'your-password'
WAKE_PASSWORD_HASH=

INSTANCE=devbox
VM_HOST=10.77.0.10
CODE_HOST=code.prabhas.io
AGENTS_HOST=agents.prabhas.io
IDLE_MINUTES=15
# stateful = save RAM to disk (sessions survive); shutdown = clean poweroff; off = never sleep
STOP_MODE=stateful
# client->server bytes per minute that count as "you're using it" (see /__devbox/history to tune)
ACTIVITY_BYTES_PER_MIN=4096
