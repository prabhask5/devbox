  "HubState": {
   "description": "Everything the agents app shows, pushed over /api/stream on every change.",
   "type": "object",
   "required": [
    "v",
    "serverNow",
    "sessions",
    "devbox",
    "adapters",
    "commonKeys",
    "pushDevices"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "serverNow": {
     "description": "The hub's clock (Unix time, ms).",
     "type": "integer"
    },
    "sessions": {
     "description": "Every session, most recently changed first.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/Session"
     }
    },
    "devbox": {
     "$ref": "#/$defs/HubStatus"
    },
    "adapters": {
     "description": "The agents the hub knows.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/AdapterInfo"
     }
    },
    "commonKeys": {
     "description": "Keys offered for every terminal session.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/AnswerKey"
     }
    },
    "vapidPublicKey": {
     "description": "Web push application server key, base64url.",
     "type": "string"
    },
    "pushDevices": {
     "description": "Devices subscribed to notifications.",
     "type": "integer"
    }
   }
  },
  "HubStatus": {
   "description": "What the hub tells the gateway at GET /devbox/status: whether the VM may sleep, sync progress, versions.",
   "type": "object",
   "required": [
    "v",
    "version",
    "uptime",
    "idle",
    "sync"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "version": {
     "description": "Commit the hub was built from.",
     "type": "string"
    },
    "uptime": {
     "description": "Seconds since the hub started.",
     "type": "integer"
    },
    "idle": {
     "$ref": "#/$defs/HubIdle"
    },
    "sync": {
     "$ref": "#/$defs/SyncState"
    },
    "deploy": {
     "$ref": "#/$defs/DeployState"
    }
   }
  },
  "HubWake": {
   "description": "What the gateway posts to the hub (POST /devbox/wake) once the VM is up.",
   "type": "object",
   "required": [
    "v",
    "now",
    "kind"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "now": {
     "description": "The host's clock, to correct the guest clock after a restore (Unix time, ms).",
     "type": "integer"
    },
    "kind": {
     "$ref": "#/$defs/WakeKind"
    }
   }
  },
  "HubWakeResponse": {
   "description": "The hub's answer to POST /devbox/wake.",
   "type": "object",
   "required": [
    "v",
    "runId"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "runId": {
     "description": "The sync run to wait for.",
     "type": "string"
    }
   }
  },
  "LastStop": {
   "description": "One sleep of the VM.",
   "type": "object",
   "required": [
    "at",
    "reason",
    "mode",
    "ms"
   ],
   "properties": {
    "at": {
     "description": "When the VM stopped (Unix time, ms).",
     "type": "integer"
    },
    "reason": {
     "description": "Why, e.g. `idle 15m`.",
     "type": "string"
    },
    "mode": {
     "description": "How: `stateful`, `shutdown`, or `shutdown (stateful failed)`.",
     "type": "string"
    },
    "ms": {
     "description": "How long stopping took, in ms.",
     "type": "integer"
    }
   }
  },
  "PhaseDurations": {
   "description": "Milliseconds per wake phase.",
   "type": "object",
   "required": [
    "start",
    "code",
    "hub",
    "sync"
   ],
   "properties": {
    "start": {
     "description": "The `start` phase.",
     "type": "integer"
    },
    "code": {
     "description": "The `code` phase.",
     "type": "integer"
    },
    "hub": {
     "description": "The `hub` phase.",
     "type": "integer"
    },
    "sync": {
     "description": "The `sync` phase.",
     "type": "integer"
    }
   }
  },
  "PhaseTiming": {
   "description": "When one wake phase ran.",
   "type": "object",
   "required": [
    "start"
   ],
   "properties": {
    "start": {
     "description": "When the phase began (Unix time, ms).",
     "type": "integer"
