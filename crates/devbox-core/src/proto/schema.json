   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "type": {
     "description": "What this line reports.",
     "type": "string",
     "enum": [
      "start",
      "begin",
      "repo",
      "done"
     ]
    },
    "total": {
     "description": "Repositories in this run.",
     "type": "integer"
    },
    "name": {
     "description": "Repository directory name, or `fetching` while all repositories are fetched.",
     "type": "string"
    },
    "status": {
     "$ref": "#/$defs/SyncStatus"
    },
    "detail": {
     "description": "One line for the owner.",
     "type": "string"
    }
   }
  },
  "SyncResult": {
   "description": "Outcome of syncing one repository.",
   "type": "object",
   "required": [
    "name",
    "status",
    "detail"
   ],
   "properties": {
    "name": {
     "description": "Repository directory name.",
     "type": "string"
    },
    "status": {
     "$ref": "#/$defs/SyncStatus"
    },
    "detail": {
     "description": "One line for the owner, e.g. `pulled 3`.",
     "type": "string"
    }
   }
  },
