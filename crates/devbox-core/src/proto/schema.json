{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$defs": {
  "AdapterInfo": {
   "description": "One kind of agent.",
   "type": "object",
   "required": [
    "id",
    "label",
    "short",
    "kind",
    "available",
    "hooks",
    "answerKeys"
   ],
   "properties": {
    "id": {
     "description": "Adapter id, e.g. `claude`.",
     "type": "string"
    },
    "label": {
     "description": "Full name, e.g. `Claude Code`.",
     "type": "string"
    },
    "short": {
     "description": "Short name, e.g. `Claude`.",
     "type": "string"
    },
    "kind": {
     "description": "How the hub talks to it: a terminal in tmux, or a chat API (reserved).",
     "type": "string",
     "enum": [
      "tmux",
      "chat"
     ]
    },
    "available": {
     "description": "Its binary is installed.",
     "type": "boolean"
    },
    "hooks": {
     "description": "It reports lifecycle events.",
     "type": "boolean"
    },
    "answerKeys": {
     "description": "Buttons shown when a session of this agent needs input.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/AnswerKey"
     }
    }
   }
  },
  "AgentEvent": {
   "description": "One lifecycle event of a coding agent, sent by the hook relay to the hub over the internal socket.",
   "type": "object",
   "required": [
    "v",
    "agent",
    "event",
    "cwd",
    "ts",
    "payload"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "agent": {
     "description": "Adapter id, e.g. `claude`.",
     "type": "string"
    },
    "event": {
     "description": "What happened. `Notification` is Claude's own event, which the hub maps onto the others.",
     "type": "string",
     "enum": [
      "SessionStart",
      "UserPromptSubmit",
      "PreToolUse",
      "PostToolUse",
      "PermissionRequest",
      "Notification",
      "Stop",
      "Error",
      "SessionEnd"
     ]
    },
    "devboxSession": {
     "description": "`$DEVBOX_SESSION` of the agent's process, when the hub started it.",
     "type": "string"
    },
    "tmuxPane": {
     "description": "`$TMUX_PANE` of the agent's process, when it runs in tmux.",
     "type": "string"
    },
    "cwd": {
     "description": "Working directory of the agent.",
     "type": "string"
    },
    "ts": {
     "description": "When the event happened (Unix time, ms).",
     "type": "integer"
    },
    "payload": {
     "description": "The agent's hook JSON as received; a string when it was not valid JSON."
    }
   }
  },
  "AnswerKey": {
   "description": "A button that sends one key to a session.",
   "type": "object",
   "required": [
    "label",
    "key"
   ],
   "properties": {
    "label": {
     "description": "Text on the button.",
     "type": "string"
    },
    "key": {
     "description": "tmux key name, e.g. `Enter` or `Escape`.",
     "type": "string"
    }
   }
  },
  "DeployState": {
   "description": "The last self-update of the hub.",
   "type": "object",
   "required": [
    "status",
    "version"
   ],
   "properties": {
    "status": {
     "description": "How the last update went.",
     "type": "string",
     "enum": [
      "success",
      "failure",
      "in_progress"
     ]
    },
    "version": {
     "description": "Commit the update installs or installed.",
     "type": "string"
    },
    "at": {
     "description": "When the update finished (Unix time, ms).",
     "type": "integer"
    },
    "error": {
     "description": "Why it failed.",
     "type": "string"
    }
   }
  },
  "DotfilesManifest": {
   "description": "`devbox.toml` at the root of a dotfiles repository: what devbox installs from it. Paths are relative to the repository root.",
   "type": "object",
   "required": [
    "version"
   ],
   "properties": {
    "version": {
     "description": "Version of this file's format.",
     "type": "integer"
    },
    "vm": {
     "description": "Additions to the VM.",
     "type": "object",
     "required": [],
     "properties": {
      "packages": {
       "description": "apt packages on top of devbox's base set.",
       "type": "array",
       "items": {
        "type": "string",
        "format": "devbox-nonempty"
       },
       "default": []
      },
      "install": {
       "description": "Script run as the VM user after provisioning; must be idempotent.",
       "type": "string",
       "format": "devbox-relpath"
      }
     },
     "default": {}
    },
    "shell": {
     "description": "Shell and git configuration.",
     "type": "object",
     "required": [],
     "properties": {
      "bashrc": {
       "description": "File sourced from ~/.bashrc.",
       "type": "string",
       "format": "devbox-relpath"
      },
      "gitconfig": {
       "description": "File included from ~/.gitconfig.",
       "type": "string",
       "format": "devbox-relpath"
      }
     },
     "default": {}
    },
    "code_server": {
     "description": "Editor configuration.",
     "type": "object",
     "required": [],
     "properties": {
      "settings": {
       "description": "settings.json linked into code-server's User directory.",
       "type": "string",
       "format": "devbox-relpath"
      },
      "keybindings": {
       "description": "keybindings.json linked into code-server's User directory.",
       "type": "string",
       "format": "devbox-relpath"
      },
      "extensions": {
       "description": "File with one Open VSX extension id per line.",
       "type": "string",
       "format": "devbox-relpath"
      }
     },
     "default": {}
    },
    "agents": {
     "description": "Agent instructions.",
     "type": "object",
     "required": [],
     "properties": {
      "instructions": {
       "description": "Instructions every agent reads.",
       "type": "string",
       "format": "devbox-relpath"
      }
     },
     "default": {}
    },
    "context": {
     "description": "Generated developer context.",
     "type": "object",
     "required": [],
     "properties": {
      "dir": {
       "description": "Directory of the dotfiles `devbox context` writes to. Absent: `context`.",
       "type": "string",
       "format": "devbox-relpath"
      },
      "ai": {
       "description": "Write an AI summary.",
       "type": "boolean",
       "default": true
      },
      "commit": {
       "description": "Commit the context directory after each run.",
       "type": "boolean",
       "default": true
      }
     },
     "default": {}
    },
    "sync": {
     "description": "Which repositories are cloned and synced.",
     "type": "object",
     "required": [],
     "properties": {
      "owner": {
       "description": "Whose repositories to clone. Absent: the authenticated GitHub user.",
       "type": "string",
       "format": "devbox-nonempty"
      },
      "include_orgs": {
       "description": "Extra owners or organizations.",
       "type": "array",
       "items": {
        "type": "string",
        "format": "devbox-nonempty"
       },
       "default": []
      },
      "exclude": {
       "description": "Globs on repository names to leave out.",
       "type": "array",
       "items": {
        "type": "string",
        "format": "devbox-nonempty"
       },
       "default": []
      },
      "archived": {
       "description": "Include archived repositories.",
       "type": "boolean",
       "default": false
      }
     },
     "default": {}
    }
   }
  },
  "GatewayEvent": {
   "$ref": "#/$defs/GatewayStatus"
  },
  "GatewayHealth": {
   "description": "Health of the devbox for monitors, served at /__devbox/health (200 when ok, 503 otherwise).",
   "type": "object",
   "required": [
    "v",
    "status",
    "problems",
    "vm",
    "phase",
    "checkedAt"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "status": {
     "description": "`ok`, or `problem` when `problems` is not empty.",
     "type": "string",
     "enum": [
      "ok",
      "problem"
     ]
    },
    "problems": {
     "description": "One stable sentence per problem.",
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "vm": {
     "$ref": "#/$defs/VmState"
    },
    "phase": {
     "$ref": "#/$defs/GatewayPhase"
    },
    "checkedAt": {
     "description": "When this was computed (Unix time, ms).",
     "type": "integer"
    }
   }
  },
  "GatewayIdle": {
   "description": "How long the devbox has been idle and why.",
   "type": "object",
   "required": [
    "idleMs",
    "gatewayIdleMs",
    "limitMs",
    "hubReasons"
   ],
   "properties": {
    "idleMs": {
     "description": "The smaller of the gateway's and the hub's idle time, in ms.",
     "type": "integer"
    },
    "gatewayIdleMs": {
     "description": "Time since the last activity through the gateway, in ms.",
     "type": "integer"
    },
    "hubIdleMs": {
     "description": "Time the hub reports being idle, in ms; absent when the hub is unreachable.",
     "type": "integer"
    },
    "limitMs": {
     "description": "Idle time after which the VM sleeps, in ms.",
     "type": "integer"
    },
    "hubReasons": {
     "description": "Why the hub is busy, if it is.",
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "GatewayPhase": {
   "description": "What the gateway is doing with the VM.",
   "type": "string",
   "enum": [
    "idle",
    "waking",
    "stopping"
   ]
  },
  "GatewaySshKeysUsed": {
   "description": "When each paired SSH key was last used, kept by the gateway in its state directory (`ssh/keys-used.json`) and read by `devbox ssh keys`.",
   "type": "object",
   "required": [
    "v",
    "keys"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "keys": {
     "description": "One entry per key that has been used.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/SshKeyUse"
     }
    }
   }
  },
  "GatewayStatus": {
   "description": "State of the gateway and the VM, served at /__devbox/status and pushed over /__devbox/events.",
   "type": "object",
   "required": [
    "v",
    "version",
    "serverNow",
    "configured",
    "vm",
    "phase",
    "typical"
   ],
   "properties": {
    "v": {
     "description": "Contract version of this message.",
     "type": "integer"
    },
    "version": {
     "description": "Commit the gateway was built from.",
     "type": "string"
    },
    "serverNow": {
     "description": "The gateway's clock, so pages can compute elapsed times (Unix time, ms).",
     "type": "integer"
    },
    "configured": {
     "description": "False until `devbox up` has written the host config.",
     "type": "boolean"
    },
    "authed": {
     "description": "Whether this request carries a valid wake cookie. Only on /__devbox/status.",
     "type": "boolean"
    },
    "vm": {
     "$ref": "#/$defs/VmState"
    },
    "phase": {
     "$ref": "#/$defs/GatewayPhase"
    },
    "idle": {
     "$ref": "#/$defs/GatewayIdle"
    },
    "lastStop": {
     "$ref": "#/$defs/LastStop"
    },
    "wake": {
     "$ref": "#/$defs/Wake"
    },
    "typical": {
     "description": "Typical phase durations, from past wakes.",
     "type": "object",
     "required": [
      "restore",
      "cold"
     ],
     "properties": {
      "restore": {
       "$ref": "#/$defs/WakeEstimate"
      },
      "cold": {
       "$ref": "#/$defs/WakeEstimate"
      }
     }
    }
   }
  },
  "HostConfig": {
   "description": "Host configuration, /etc/devbox/devbox.toml: written by `devbox up`, read by the CLI and the gateway.",
   "type": "object",
   "required": [
    "version",
    "domain",
    "vm"
   ],
   "properties": {
    "version": {
     "description": "Version of this file's format.",
     "type": "integer"
    },
    "instance": {
     "description": "Incus instance name.",
     "type": "string",
     "format": "devbox-name",
     "default": "devbox"
    },
    "domain": {
     "description": "Domain the devbox is served under.",
     "type": "string",
     "format": "hostname"
    },
    "hosts": {
     "description": "Public hostnames.",
     "type": "object",
     "required": [],
     "properties": {
      "code": {
       "description": "Editor hostname. Default: `code.<domain>`.",
       "type": "string",
       "format": "hostname"
      },
      "agents": {
       "description": "Agents app hostname. Default: `agents.<domain>`.",
       "type": "string",
       "format": "hostname"
      },
      "ssh": {
       "description": "SSH hostname (SSH over WebSocket, the setup script and pairing). Default: `devbox.<domain>`.",
       "type": "string",
       "format": "hostname"
      }
     },
     "default": {}
    },
    "vm": {
     "description": "How the gateway reaches the VM.",
     "type": "object",
     "required": [
      "address"
     ],
     "properties": {
      "address": {
       "description": "Static address of the VM on the Incus bridge.",
       "type": "string",
       "format": "ipv4"
      },
      "code_port": {
       "description": "code-server port.",
       "type": "integer",
       "format": "uint16",
       "minimum": 1,
       "default": 8080
      },
      "hub_port": {
       "description": "Hub port.",
       "type": "integer",
       "format": "uint16",
       "minimum": 1,
       "default": 8090
      },
      "ssh_port": {
       "description": "sshd port.",
       "type": "integer",
       "format": "uint16",
       "minimum": 1,
       "default": 22
      },
      "ssh_host_key": {
       "description": "The VM's SSH host key, as one `ssh-ed25519 AAAA…` line, recorded by `devbox up`. The gateway connects to no other. Absent until `devbox up` has run.",
       "type": "string",
       "format": "devbox-nonempty"
      }
     }
    },
    "sleep": {
     "description": "When the VM is put to sleep.",
     "type": "object",
     "required": [],
     "properties": {
      "idle": {
       "description": "Idle time after which the VM sleeps.",
       "type": "string",
       "format": "devbox-duration",
       "default": "15m"
      },
      "min_up": {
       "description": "Minimum time the VM stays up after a wake.",
       "type": "string",
       "format": "devbox-duration",
       "default": "5m"
      },
      "mode": {
       "description": "`stateful` saves memory, `shutdown` stops cleanly, `off` never sleeps.",
       "type": "string",
       "enum": [
        "stateful",
        "shutdown",
        "off"
       ],
       "default": "stateful"
      },
      "activity_bytes_per_min": {
       "description": "Client bytes per minute that count as activity.",
       "type": "integer",
       "minimum": 0,
       "default": 4096
      }
     },
     "default": {}
    },
    "gateway": {
     "description": "Gateway listeners and timing.",
     "type": "object",
     "required": [],
     "properties": {
      "listen": {
       "description": "HTTP listen address.",
       "type": "string",
       "format": "devbox-listen",
       "default": ":8080"
      },
      "ssh_listen": {
       "description": "SSH proxy listen address; empty disables SSH proxying.",
       "type": "string",
       "format": "devbox-listen-optional",
       "default": ":2222"
      },
      "sync_wait": {
       "description": "How long a wake waits for the repo sync before going on without it.",
       "type": "string",
       "format": "devbox-duration",
       "default": "90s"
      }
     },
     "default": {}
    },
    "routing": {
     "description": "How public traffic reaches the gateway.",
     "type": "object",
     "required": [],
     "properties": {
      "provider": {
       "description": "`traefik-file` writes a Traefik dynamic file; `none` leaves routing to the owner.",
       "type": "string",
       "enum": [
        "traefik-file",
        "none"
       ],
       "default": "traefik-file"
      },
      "file": {
       "description": "The Traefik dynamic file devbox owns.",
       "type": "string",
       "format": "devbox-abspath",
       "default": "/etc/dokploy/traefik/dynamic/devbox.yml"
      },
      "entrypoint": {
       "description": "Traefik entrypoint for the routes.",
       "type": "string",
       "format": "devbox-nonempty",
       "default": "websecure"
      },
      "service_url": {
       "description": "URL Traefik uses to reach the gateway.",
       "type": "string",
       "format": "devbox-url",
       "default": "http://devbox-gateway:8080"
      }
     },
     "default": {}
    },
    "firewall": {
     "description": "What puts the firewall rule for the VM in force.",
     "type": "object",
     "required": [],
     "properties": {
      "manager": {
       "description": "The firewall manager `devbox up` uses: `host-firewall`, `ufw`, `nftables`, `moi`, `none`, or the name of an embedder's own. Absent: `devbox up` finds out which.",
       "type": "string",
       "format": "devbox-nonempty"
      }
     },
     "default": {}
    },
    "provision": {
     "description": "How `devbox up` built the VM, so that it can build it again without being asked anything.",
     "type": "object",
     "required": [],
     "properties": {
      "user": {
       "description": "The user in the VM that owns the repositories and the agent sessions. Absent until `devbox up` has run.",
       "type": "string",
       "format": "devbox-nonempty"
      },
      "cpu": {
       "description": "vCPUs of the VM.",
       "type": "integer",
       "default": 3
      },
      "memory": {
       "description": "Memory of the VM, like `5GiB`.",
       "type": "string",
       "format": "devbox-nonempty",
       "default": "5GiB"
      },
      "disk": {
       "description": "Root disk of the VM, like `60GiB`.",
       "type": "string",
       "format": "devbox-nonempty",
       "default": "60GiB"
      },
      "image": {
       "description": "Image the VM is created from, as `remote:alias`.",
       "type": "string",
       "format": "devbox-nonempty",
       "default": "images:ubuntu/26.04/cloud"
      },
      "agents": {
       "description": "Coding agents installed in the VM.",
       "type": "array",
       "items": {
        "type": "string",
        "format": "devbox-nonempty"
       },
       "default": [
        "claude",
        "codex",
        "opencode"
       ]
      },
      "dotfiles": {
       "description": "The owner's dotfiles repository, cloned into the VM and applied.",
       "type": "string",
       "format": "devbox-nonempty"
      }
     },
     "default": {}
    },
    "deploy": {
     "description": "Continuous deployment of the hub.",
     "type": "object",
     "required": [],
     "properties": {
      "repo": {
       "description": "GitHub repository whose deployments the VM installs. Absent: the hub does not update itself.",
       "type": "string",
       "format": "devbox-repo"
      },
      "hub_environment": {
       "description": "GitHub environment of the hub's deployments.",
       "type": "string",
       "format": "devbox-nonempty",
       "default": "agents-hub"
      },
      "wake_to_deploy": {
       "description": "Wake a sleeping VM to install a new hub build.",
       "type": "boolean",
       "default": false
      }
     },
     "default": {}
    }
   }
  },
  "HostSecrets": {
   "description": "Host secrets, /etc/devbox/secrets.toml (mode 0600).",
   "type": "object",
   "required": [
    "version",
    "wake_password_hash",
    "cookie_secret",
    "hub_token"
   ],
   "properties": {
    "version": {
     "description": "Version of this file's format.",
     "type": "integer"
    },
    "wake_password_hash": {
     "description": "argon2id hash (PHC string) of the password that wakes the VM.",
     "format": "devbox-phc",
     "type": "string",
     "x-rust-type": {
      "crate": "devbox-core",
      "version": "*",
      "path": "devbox_core::secret::Secret"
     },
     "goJSONSchema": {
      "type": "secret.Secret",
      "imports": [
       "github.com/prabhask5/devbox/internal/secret"
      ]
     }
    },
    "cookie_secret": {
     "description": "Key that signs wake cookies.",
     "format": "devbox-nonempty",
     "type": "string",
     "x-rust-type": {
      "crate": "devbox-core",
      "version": "*",
      "path": "devbox_core::secret::Secret"
     },
     "goJSONSchema": {
      "type": "secret.Secret",
      "imports": [
       "github.com/prabhask5/devbox/internal/secret"
      ]
     }
    },
    "hub_token": {
     "description": "Bearer token the gateway presents to the hub.",
     "format": "devbox-nonempty",
     "type": "string",
     "x-rust-type": {
      "crate": "devbox-core",
      "version": "*",
      "path": "devbox_core::secret::Secret"
     },
     "goJSONSchema": {
      "type": "secret.Secret",
      "imports": [
       "github.com/prabhask5/devbox/internal/secret"
      ]
     }
    },
    "app_password_hash": {
     "description": "argon2id hash of the agents app's password, kept here too so that a rebuilt VM gets it back without anyone being asked. The gateway does not read it.",
     "type": "string",
     "format": "devbox-phc"
    }
   }
  },
  "HubConfig": {
   "description": "Hub configuration, ~/.config/devbox/hub.toml in the VM.",
   "type": "object",
   "required": [
    "version",
    "hosts"
   ],
   "properties": {
    "version": {
     "description": "Version of this file's format.",
     "type": "integer"
    },
    "listen": {
     "description": "Listen address for the app and the gateway API.",
     "type": "string",
     "format": "devbox-listen",
     "default": ":8090"
    },
    "hosts": {
     "description": "Public hostnames, for links the hub hands out.",
     "type": "object",
     "required": [
      "code",
      "agents"
     ],
     "properties": {
      "code": {
       "description": "Editor hostname.",
       "type": "string",
       "format": "hostname"
      },
      "agents": {
       "description": "Agents app hostname.",
       "type": "string",
       "format": "hostname"
      }
     }
    },
    "tmux": {
     "description": "The tmux server that holds agent sessions.",
     "type": "object",
     "required": [],
     "properties": {
      "socket": {
       "description": "tmux socket name (`tmux -L`).",
       "type": "string",
       "format": "devbox-name",
       "default": "devbox"
      }
     },
     "default": {}
    },
    "deploy": {
     "description": "Self-update from GitHub Deployments.",
     "type": "object",
     "required": [],
     "properties": {
      "repo": {
       "description": "GitHub repository whose deployments the VM installs. Absent: the hub does not update itself.",
       "type": "string",
       "format": "devbox-repo"
      },
      "environment": {
       "description": "GitHub environment of the hub's deployments.",
